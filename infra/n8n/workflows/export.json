          "conditions": [
            {
              "id": "81ce81d9-10b6-5fa9-9a0c-65e8d0373ff1",
              "leftValue": "={{ $('Webhook').first().json.body.alert }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
