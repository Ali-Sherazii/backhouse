    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.error) throw new Error('Odoo: ' + JSON.stringify(r.error.data?.message || r.error.message));\nreturn [{ json: { odoo_bill_id: r.result, odoo_partner_id: $('Build bill').first().json.partner_id } }];"
      },
      "id": "61154589-8ba2-5d70-be7e-d62338642de1",
