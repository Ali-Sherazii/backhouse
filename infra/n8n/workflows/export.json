    {
      "parameters": {
        "jsCode": "return [{ json: { partner_id: $input.first().json.result[0].id } }];"
      },
      "id": "f319f535-9d1a-506e-ac4d-bea9471530a9",
      "name": "Use existing partner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ODOO_URL }}/jsonrpc",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { service: 'object', method: 'execute_kw', args: [$env.ODOO_DB, $('Odoo login').first().json.result, $env.ODOO_PASSWORD, 'res.partner', 'create', [{ name: $('Webhook').first().json.body.vendor.name, is_company: true, supplier_rank: 1, vat: $('Webhook').first().json.body.vendor.tax_id || false }], {}] } }) }}",
        "options": {}
      },
      "id": "361c59b5-a051-5a2c-80b0-c9616db771be",
      "name": "Create partner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.error) throw new Error('Odoo: ' + JSON.stringify(r.error.data?.message || r.error.message));\nreturn [{ json: { partner_id: r.result } }];"
      },
      "id": "7f069c20-c6c8-58a7-b790-3b18ba8ca8be",
      "name": "Use new partner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Webhook').first().json.body;\nconst inv = p.invoice;\nconst lines = (inv.lines || []).map(l => [0, 0, {\n  name: l.description || 'Item',\n  quantity: l.quantity ?? 1,\n  price_unit: l.unit_price ?? l.amount ?? 0,\n  tax_ids: [[6, 0, []]],\n}]);\nif (inv.discount) {\n  lines.push([0, 0, { name: 'Discount (as invoiced)', quantity: 1, price_unit: -Math.abs(inv.discount), tax_ids: [[6, 0, []]] }]);\n}\nif (inv.tax) {\n  lines.push([0, 0, { name: 'Sales tax (as invoiced)', quantity: 1, price_unit: inv.tax, tax_ids: [[6, 0, []]] }]);\n}\nconst vals = {\n  move_type: 'in_invoice',\n  partner_id: $json.partner_id,\n  ref: inv.number,\n  invoice_date: inv.date,\n  narration: `Imported by Backhouse from document #${p.document_id}: ${p.document_url}`,\n  invoice_line_ids: lines,\n};\nif (inv.due_date) vals.invoice_date_due = inv.due_date;\nreturn [{ json: { partner_id: $json.partner_id, vals } }];"
      },
      "id": "8000a29d-0943-5707-89da-67ea1a26f2e0",
      "name": "Build bill",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ODOO_URL }}/jsonrpc",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { service: 'object', method: 'execute_kw', args: [$env.ODOO_DB, $('Odoo login').first().json.result, $env.ODOO_PASSWORD, 'account.move', 'create', [$json.vals], {}] } }) }}",
        "options": {}
      },
      "id": "35d668e2-0144-5cda-8d14-f7c8a8049b18",
      "name": "Create bill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        280
