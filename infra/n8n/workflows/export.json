        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { service: 'object', method: 'execute_kw', args: [$env.ODOO_DB, $('Odoo login').first().json.result, $env.ODOO_PASSWORD, 'res.partner', 'search_read', [$('Webhook').first().json.body.vendor.odoo_partner_id ? [['id', '=', $('Webhook').first().json.body.vendor.odoo_partner_id]] : [['name', '=ilike', $('Webhook').first().json.body.vendor.name], ['is_company', '=', true]]], { fields: ['id', 'name'], limit: 1 }] } }) }}",
