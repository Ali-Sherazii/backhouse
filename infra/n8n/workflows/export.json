      "id": "8e955b30-7409-5e8a-820f-1a4752d7e10a",
      "name": "Alert needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2420,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Webhook').first().json.body;\nconst bill = $('Check Odoo result').first().json.odoo_bill_id;\nconst head = `Invoice ${p.invoice.number} from ${p.vendor.name} (${p.invoice.currency || ''} ${p.invoice.total}) was approved by ${p.approved_by} and sent to Odoo as bill #${bill}.`;\nconst lines = [head, ''];\nif (p.guard_flagged) lines.push('- The injection guard flagged this document before it was approved. Check it was intended.');\nfor (const w of p.warnings || []) lines.push(`- ${w.check === 'price_change' ? 'Price change' : w.check}: ${w.detail}`);\nlines.push('', `Open in Backhouse: ${p.document_url}`);\nconst subject = p.guard_flagged\n  ? `[Backhouse] Flagged invoice approved: ${p.vendor.name} ${p.invoice.number}`\n  : `[Backhouse] Price change: ${p.vendor.name} ${p.invoice.number}`;\nreturn [{ json: { subject, text: lines.join('\\n') } }];"
      },
