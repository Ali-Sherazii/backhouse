flowchart TB
    subgraph IN["Invoices come in"]
        direction LR
        WEB["Web app<br/>upload, phone photo, samples"]
        MAIL["Supplier email<br/>invoices@ address"]
    end

    WEB --> CADDY["Caddy (HTTPS)"] --> API["FastAPI<br/>auth, REST, webhooks"]
    MAIL --> MP["Mailpit SMTP inbox"] --> N8NI["n8n intake workflow"] -->|"attachment + shared secret"| API

    API --> PG[("Postgres")]
    API --> S3[("MinIO<br/>originals, page images")]
    API -->|"Celery job"| RQ[("Redis queue")]

    subgraph WK["Worker pipeline"]
        T["Text and positions<br/>PyMuPDF, Docling OCR"] --> G["Injection guard<br/>hidden text, layer vs OCR,<br/>Prompt Guard 2, keywords"]
        G -->|"sanitised, spotlighted text"| X["Extract<br/>Qwen2.5 on Ollama, JSON schema"]
        X --> GR["Ground<br/>find each value on the page"]
        GR --> V["Validate<br/>totals, dates, vendor,<br/>duplicates, price changes"]
        V --> D{"Decide"}
    end

    RQ --> T
    X -. "trace" .-> LF["Langfuse tracing"]
    D -->|"clean and confident"| OK["Approved"]
    D -->|"anything uncertain"| RV["Review screen<br/>a person checks and approves"]
    RV --> OK
    OK --> N8NE["n8n export workflow"] -->|"JSON-RPC"| ODOO["Odoo 17 vendor bill"]
    N8NE -->|"bill id"| API
    N8NE --> AL["Slack or email alert<br/>price change, flagged invoice"]
